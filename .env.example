NODE_ENV=development
# OpenAI (image edits)
OPENAI_API_KEY=
# TikTok (OAuth & posting) - you must register an app with TikTok for Developers
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Set this to your deployed callback URL (example below)
TIKTOK_REDIRECT_URI=https://altermehq.online/api/tiktok/callback
# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox # or live
# Optional: AWS S3 for image storage (or use Vercel Blob / temporary storage)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Vercel (optional)
VERCEL_TOKEN=
